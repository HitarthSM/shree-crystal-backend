# App
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/shree_crystal_db

# Auth / JWT
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-characters-long!!
JWT_EXPIRES_IN=7d
DEFAULT_MEMBER_PASSWORD=Shree@123

# SMS Gateway
SMS_GATEWAY_KEY=your-sms-gateway-api-key

# Email / SMTP
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=no-reply@example.com
EMAIL_SMTP_PASS=your-smtp-password

# CORS — frontend origin (no trailing slash)
FRONTEND_ORIGIN=http://localhost:3001

# Swagger — set to false in production to hide /api/docs
SWAGGER_ENABLED=true

# Super Admin seed (used ONLY by prisma/seed.ts — never expose in API responses)
# Set these before running: npm run prisma:seed
SUPER_ADMIN_EMAIL=admin@your-society.com
SUPER_ADMIN_PASSWORD=ReplaceWithStrongPassword@123
SUPER_ADMIN_NAME=Super Admin

# Field-level encryption key for Aadhaar / PAN stored in Member table
# Generate with: openssl rand -hex 32
# KEEP THIS SECRET — rotating it requires re-encrypting all existing values
FIELD_ENCRYPTION_KEY=replace-with-64-hex-chars-from-openssl-rand-hex-32

# ── Environment Specific Configurations ───────────────────────────────────────
# For staging, create a `.env.staging` file (NEVER commit it) with at minimum:
# NODE_ENV=staging
# DATABASE_URL=postgresql://USER:PASSWORD@staging-host:5432/shree_crystal_staging_db
# JWT_SECRET=your-secure-staging-jwt-secret
# FIELD_ENCRYPTION_KEY=your-secure-staging-field-encryption-key
# FRONTEND_ORIGIN=https://staging.your-society.com
# SWAGGER_ENABLED=true
# 
# For production, create a `.env.production` file (NEVER commit it) with at minimum:
# NODE_ENV=production
# DATABASE_URL=postgresql://USER:PASSWORD@prod-host:5432/shree_crystal_prod_db
# JWT_SECRET=your-secure-production-jwt-secret (must be long and unguessable)
# FIELD_ENCRYPTION_KEY=your-secure-production-field-encryption-key (keep highly secure)
# FRONTEND_ORIGIN=https://your-society.com
# SWAGGER_ENABLED=false
